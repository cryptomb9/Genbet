# ---- Required ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather

# Address that receives the 10% house fee from every resolved bet.
HOUSE_FEE_ADDRESS=0xYourEvmWalletAddress

# House fee in basis points (10000 = 100%). 1000 = 10%.
HOUSE_FEE_BPS=1000

# GenLayer network: testnet-asimov | testnet-bradbury | localnet
GENLAYER_NETWORK=testnet-asimov

# ---- Optional ----
# Where local data (SQLite, contract address cache) is stored
DATA_DIR=./data

# 32-byte hex string used to encrypt user wallet private keys at rest.
# If unset, a key is auto-generated and saved to data/.session_key.
# IMPORTANT: back this up. If you lose it, all stored user wallets are unrecoverable.
SESSION_SECRET=

# OpenAI-compatible endpoint for natural-language bet parsing in groups.
# On Replit, these are auto-set. For self-hosting, set both to use OpenAI.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Override the deployed BetMarket contract address. If unset, the bot
# will deploy a new one on first run and persist the address to data/.
BET_MARKET_ADDRESS=

# Operator wallet (deploys the contract, pays gas for resolve calls).
# If unset, one is auto-generated and saved to data/.operator_key.
# IMPORTANT: back this up.
OPERATOR_PRIVATE_KEY=
